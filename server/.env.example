# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://audiobooks:audiobooks@localhost:5432/audiobooks

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3-compatible storage (MinIO in docker-compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=audiobooks
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/audiobooks
S3_USE_PRESIGNED=false
S3_PRESIGNED_EXPIRES_SEC=3600

# Временные PDF до загрузки в S3 (Celery ingest)
UPLOAD_TEMP_DIR=/tmp/audiobooks

# Demo user (MVP без авторизации)
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# OCR
OCR_MAX_PAGES=50

# TTS: yandex (основной) | mock (CI без сети)
TTS_PROVIDER=yandex
TTS_MAX_CHARS=8000
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_VOICE=filipp

# NLP
SPACY_MODEL=ru_core_news_sm
